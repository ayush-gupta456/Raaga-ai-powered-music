{
  "name": "raaga-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --test tests/*.test.mjs",
    "build:node": "vite build --config vite.node.config.ts",
    "start:node": "node --env-file-if-exists=.env server/index.mjs",
    "build:vercel": "npm run build:node && node scripts/build-vercel.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.14",
    "better-auth": "^1.7.14",
    "better-call": "^1.4.4",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.31.0",
    "mongodb": "^7.7.0",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "posthog-js": "^1.442.0",
    "posthog-node": "^5.57.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261029.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.3.1",
    "typescript": "5.9.3",
    "vinext": "1.4.0",
    "vite": "8.3.5",
    "wrangler": "4.155.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "fflate": "0.8.3"
  },
  "description": "Lyrics-first AI music studio with personal ACE Music keys, secure accounts, and session-only audio.",
  "homepage": "https://raaga-studio.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayush-gupta456/Raaga-ai-powered-music.git"
  },
  "bugs": {
    "url": "https://github.com/ayush-gupta456/Raaga-ai-powered-music/issues"
  },
  "keywords": [
    "ai-music",
    "ace-step",
    "lyrics",
    "react",
    "express",
    "mongodb"
  ]
}
