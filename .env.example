# Server-only. Never prefix these with VITE_ or NEXT_PUBLIC_.
ACESTEP_API_KEY=
# Optional: otherwise discover the account's available ACE-Step model.
ACESTEP_MODEL=
MUSIC_TIMEOUT_MS=600000
MUSIC_MAX_CONCURRENT=2
MUSIC_MAX_REQUESTS=3
MUSIC_RATE_WINDOW_MS=60000
PORT=3000

# Node/Vercel account authentication (all values are SERVER ONLY)
MONGODB_URI=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Registered OpenAI website OAuth client (not an OpenAI API key)
OPENAI_OAUTH_CLIENT_ID=
OPENAI_OAUTH_CLIENT_SECRET=
# Must match your registered client: client_secret_post, client_secret_basic, or none
OPENAI_OAUTH_TOKEN_AUTH_METHOD=client_secret_post
# Public PostHog project ingestion token (phc_), not a personal API key.
# Both browser usage events and server generation traces use this project.
POSTHOG_PROJECT_TOKEN=
# Choose the region of your PostHog project: US or EU ingestion host.
POSTHOG_HOST=https://us.i.posthog.com
# Gmail authentication mail (takes priority over Resend when supplied).
# Default sender: create.personal456@gmail.com; optional override to another Gmail account.
GMAIL_USER=create.personal456@gmail.com
# Server secret only: Google's 16-character app password, never the normal Google password.
GMAIL_APP_PASSWORD=
